<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Computer - N9 | Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Exo+2:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/CSS/admin_dashboard.css">
    <script src="/JS/admin_dashboard.js" defer></script>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-icon">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <div class="logo-text">Computer - N9</div>
                </div>
                <span class="admin-badge">ADMIN PANEL</span>
            </div>

            <div class="admin-info">
                <div class="admin-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div class="admin-details">
                    <h4>Admin N9</h4>
                    <p>admin@computern9.vn</p>
                </div>
            </div>
            <div class="sidebar-menu">
                <div class="menu-category">Main</div>
                <a href="/admin" style="text-decoration: none;"><div class="menu-item active"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></div></a>
                <a href="/admin_sanpham" style="text-decoration: none;"><div class="menu-item"><i class="fas fa-box"></i><span>Sản phẩm</span></div></a>
                <a href="/admin_danhmuc" style="text-decoration: none;"><div class="menu-item" id="menu-categories"><i class="fas fa-list"></i><span>Danh mục</span></div></a>
                <a href="/admin_donhang" style="text-decoration: none;"><div class="menu-item"><i class="fas fa-shopping-cart"></i><span>Đơn hàng</span></div></a>
                <div class="menu-category">Hệ thống</div>
                <a href="/admin_user" style="text-decoration: none;"><div class="menu-item"><i class="fas fa-users"></i><span>Người dùng</span></div></a>
                <a href="/" style="text-decoration: none;"><div class="menu-item"><i class="fas fa-home"></i><span>Về Trang Chủ</span></div></a>
                <div class="menu-item" onclick="logout()"><i class="fas fa-sign-out-alt"></i><span>Đăng xuất</span></div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="admin-main">
            <!-- Top Bar -->
            <div class="top-bar">
                <h1 class="page-title">
                    <i class="fas fa-tachometer-alt"></i>
                    Dashboard
                </h1>
                <div class="top-bar-actions">
                    <div class="search-box">
                        <input type="text" placeholder="Tìm kiếm...">
                        <button><i class="fas fa-search"></i></button>
                    </div>
                    <div class="notification-btn">
                        <i class="far fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon blue">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                        <span class="trend-badge up">+12%</span>
                    </div>
                    <div class="stat-value" id="totalOrders">1,234</div>
                    <div class="stat-label">Tổng đơn hàng</div>
                    <div class="stat-footer">Tăng 12% so với tháng trước</div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon green">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                        <span class="trend-badge up">+18%</span>
                    </div>
                    <div class="stat-value" id="totalRevenue">2.45B</div>
                    <div class="stat-label">Tổng doanh thu</div>
                    <div class="stat-footer">Tăng 18% so với tháng trước</div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon purple">
                            <i class="fas fa-cube"></i>
                        </div>
                        <span class="trend-badge up">+8%</span>
                    </div>
                    <div class="stat-value" id="productsSold">5,678</div>
                    <div class="stat-label">Sản phẩm đã bán</div>
                    <div class="stat-footer">Tăng 8% so với tháng trước</div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon pink">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <span class="trend-badge down">-3</span>
                    </div>
                    <div class="stat-value" id="lowStock">8</div>
                    <div class="stat-label">Sản phẩm sắp hết hàng</div>
                    <div class="stat-footer">Cần nhập thêm 8 sản phẩm</div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon orange">
                            <i class="fas fa-users"></i>
                        </div>
                        <span class="trend-badge up">+24</span>
                    </div>
                    <div class="stat-value" id="newUsers">156</div>
                    <div class="stat-label">Người dùng mới</div>
                    <div class="stat-footer">Tăng 24 người dùng mới</div>
                </div>


            </div>

            <!-- Charts Row -->
            <div class="charts-row">
                <!-- Revenue Chart -->
                <div class="chart-card">
                    <div class="chart-header">
                        <div class="chart-title">
                            <i class="fas fa-chart-line"></i>
                            Doanh thu theo tháng
                        </div>
                        <div class="chart-period">
                            <span class="period-btn active">6 tháng</span>
                            <span class="period-btn">12 tháng</span>
                            <!-- <span class="period-btn">Năm nay</span> -->
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>

                <!-- Top Products Chart -->
                <div class="chart-card">
                    <div class="chart-header">
                        <div class="chart-title">
                            <i class="fas fa-chart-pie"></i>
                            Top sản phẩm bán chạy
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="topProductsChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tables Row -->
            <div class="tables-row">
                <!-- Sản phẩm sắp hết hàng -->
                <div class="table-card">
                    <div class="table-header">
                        <div class="table-title">
                            <i class="fas fa-exclamation-triangle" style="color: var(--neon-pink);"></i>
                            Sản phẩm sắp hết hàng
                        </div>
                        <a href="/admin_sanpham" class="view-all" style="text-decoration: none;">Xem tất cả</a>
                    </div>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Tồn kho</th>
                                <th>Đã bán</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="lowStockTable">
                            <tr>
                                <td>
                                    <div class="product-name">
                                        <div class="product-icon"><i class="fas fa-keyboard"></i></div>
                                        <span>Bàn phím Razer Huntsman</span>
                                    </div>
                                </td>
                                <td>Bàn phím</td>
                                <td>5</td>
                                <td>123</td>
                                <td><span class="stock-badge stock-low">Sắp hết</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="product-name">
                                        <div class="product-icon"><i class="fas fa-mouse"></i></div>
                                        <span>Chuột Logitech G Pro</span>
                                    </div>
                                </td>
                                <td>Chuột</td>
                                <td>3</td>
                                <td>89</td>
                                <td><span class="stock-badge stock-low">Sắp hết</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="product-name">
                                        <div class="product-icon"><i class="fas fa-headphones"></i></div>
                                        <span>Tai nghe SteelSeries</span>
                                    </div>
                                </td>
                                <td>Tai nghe</td>
                                <td>2</td>
                                <td>67</td>
                                <td><span class="stock-badge stock-low">Sắp hết</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="product-name">
                                        <div class="product-icon"><i class="fas fa-tv"></i></div>
                                        <span>Màn hình Samsung</span>
                                    </div>
                                </td>
                                <td>Màn hình</td>
                                <td>8</td>
                                <td>45</td>
                                <td><span class="stock-badge stock-medium">Còn ít</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="product-name">
                                        <div class="product-icon"><i class="fas fa-laptop"></i></div>
                                        <span>Laptop ASUS ROG</span>
                                    </div>
                                </td>
                                <td>Laptop</td>
                                <td>12</td>
                                <td>234</td>
                                <td><span class="stock-badge stock-high">Bình thường</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Đơn hàng gần đây -->
                <div class="table-card">
                    <div class="table-header">
                        <div class="table-title">
                            <i class="fas fa-shopping-bag" style="color: var(--neon-blue);"></i>
                            Đơn hàng gần đây
                        </div>
                        <a href="/admin_donhang" class="view-all" style="text-decoration: none;">Xem tất cả</a>
                    </div>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Mã ĐH</th>
                                <th>Khách hàng</th>
                                <th>Sản phẩm</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="recentOrdersTable">
                            <tr>
                                <td>#OD12345</td>
                                <td>Nguyễn Văn A</td>
                                <td>Laptop ROG + Phụ kiện</td>
                                <td>35.880.000₫</td>
                                <td><span class="status-badge status-completed">Hoàn thành</span></td>
                            </tr>
                            <tr>
                                <td>#OD12346</td>
                                <td>Trần Thị B</td>
                                <td>Bàn phím Razer</td>
                                <td>3.890.000₫</td>
                                <td><span class="status-badge status-processing">Đang xử lý</span></td>
                            </tr>
                            <tr>
                                <td>#OD12347</td>
                                <td>Lê Văn C</td>
                                <td>Chuột Logitech</td>
                                <td>2.590.000₫</td>
                                <td><span class="status-badge status-pending">Chờ xác nhận</span></td>
                            </tr>
                            <tr>
                                <td>#OD12348</td>
                                <td>Phạm Thị D</td>
                                <td>Tai nghe + Chuột</td>
                                <td>10.080.000₫</td>
                                <td><span class="status-badge status-processing">Đang xử lý</span></td>
                            </tr>
                            <tr>
                                <td>#OD12349</td>
                                <td>Hoàng Văn E</td>
                                <td>Màn hình Samsung</td>
                                <td>15.990.000₫</td>
                                <td><span class="status-badge status-cancelled">Đã hủy</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions">
                <a href="/admin_sanpham" style="text-decoration: none; color: white;"><div class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-plus"></i>
                    </div>
                    <div class="action-info">
                        <h4>Thêm sản phẩm</h4>
                        <p>Tạo sản phẩm mới</p>
                    </div>
                </div></a>
                <a href="/admin_donhang" style="text-decoration: none; color: white;"><div class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="action-info">
                        <h4>Xem đơn hàng</h4>
                        <p>Xem và quản lý đơn hàng</p>
                    </div>
                </div></a>

                <div class="action-card" onclick="showNotification('Xuất báo cáo')">
                    <div class="action-icon">
                        <i class="fas fa-file-export"></i>
                    </div>
                    <div class="action-info">
                        <h4>Xuất báo cáo</h4>
                        <p>Báo cáo doanh thu</p>
                    </div>
                </div>
                <div class="action-card" onclick="showNotification('Cài đặt hệ thống')">
                    <div class="action-icon">
                        <i class="fas fa-cog"></i>
                    </div>
                    <div class="action-info">
                        <h4>Cài đặt</h4>
                        <p>Cấu hình hệ thống</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>