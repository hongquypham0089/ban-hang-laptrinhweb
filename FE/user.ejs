<%- include('partials/header') %>

<main class="main-content">
    <div class="container">
        <!-- User Container -->
        <div class="user-container">
            <!-- Sidebar -->
            <div class="user-sidebar">
                <div class="user-profile">
                    <div class="avatar-container">
                        <div class="avatar">
                            <img src="<%= (user && user.avatar) ? user.avatar : '' %>" 
                                alt="Avatar" 
                                id="user-avatar-img" 
                                style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%; <%= (user && user.avatar) ? 'display: block;' : 'display: none;' %>">
                            <i class="fas fa-user" id="default-avatar-icon" 
                                style="<%= (user && user.avatar) ? 'display: none;' : 'display: block;' %>"></i>
                        </div>
                        <div class="avatar-badge" onclick="document.getElementById('avatar-upload').click()">
                            <i class="fas fa-camera"></i>
                        </div>
                        <input type="file" id="avatar-upload" style="display: none;" accept="image/*" onchange="uploadAvatar(this)">
                    </div>
                    
                    <h2 class="user-name">
                        <%= (user && user.TenNguoiDung) ? user.TenNguoiDung : ((user && user.TenTaiKhoan) ? user.TenTaiKhoan : 'Người dùng') %>
                    </h2>
                    <p class="user-email"><%= (user && user.Email) ? user.Email : '' %></p>
                    <div class="member-info">
                        <span class="member-badge">MEMBER GOLD</span>
                    </div>
                </div>

                <div class="user-stats">
                    <div class="stat-item">
                        <div class="stat-value" id="sidebar-total-orders">0</div>
                        <div class="stat-label">Đơn hàng</div>
                    </div>
                    <!-- <div class="stat-item">
                        <div class="stat-value" id="sidebar-points">0</div>
                        <div class="stat-label">Điểm thưởng</div>
                    </div> -->
                    <div class="stat-item">
                        <div class="stat-value" id="sidebar-discount">0</div>
                        <div class="stat-label">Voucher</div>
                    </div>
                </div>

                <div class="user-menu">
                    <div class="menu-item active" data-tab="dashboard">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Tổng quan</span>
                    </div>
                    <div class="menu-item" data-tab="profile">
                        <i class="fas fa-user"></i>
                        <span>Thông tin tài khoản</span>
                    </div>
                    <div class="menu-item" data-tab="orders">
                        <i class="fas fa-shopping-bag"></i>
                        <span>Đơn hàng của tôi</span>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="user-content">
                <div class="content-header">
                    <h1 class="content-title">
                        <i class="fas fa-tachometer-alt"></i>
                        <span id="page-title">Tổng quan</span>
                    </h1>
                </div>

                <div class="content-body">
                    <!-- Dashboard Tab -->
                    <div class="tab-pane active" id="dashboard">
                        <div class="dashboard-grid">
                            <div class="dashboard-card">
                                <div class="card-icon">
                                    <i class="fas fa-shopping-bag"></i>
                                </div>
                                <div class="card-value" id="dashboard-total-orders">0</div>
                                <div class="card-label">Tổng đơn hàng</div>
                            </div>
                            <div class="dashboard-card">
                                <div class="card-icon">
                                    <i class="fas fa-truck"></i>
                                </div>
                                <div class="card-value" id="dashboard-shipping-orders">0</div>
                                <div class="card-label">Đang giao</div>
                            </div>
                            <div class="dashboard-card">
                                <div class="card-icon">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <div class="card-value" id="dashboard-delivered-orders">0</div>
                                <div class="card-label">Đã giao</div>
                            </div>
                            <!-- <div class="dashboard-card">
                                <div class="card-icon">
                                    <i class="fas fa-star"></i>
                                </div>
                                <div class="card-value" id="dashboard-points">0</div>
                                <div class="card-label">Điểm thưởng</div>
                            </div> -->
                        </div>

                        <div class="recent-orders">
                            <h3 class="section-title">
                                <i class="fas fa-history"></i>
                                Đơn hàng gần đây
                            </h3>
                            <div id="recent-orders-container">
                                <div class="loading" style="text-align: center; padding: 40px;">Đang tải đơn hàng...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Profile Tab -->
                    <div class="tab-pane" id="profile">
                        <h3 class="section-title">
                            <i class="fas fa-user-edit"></i>
                            Thông tin cá nhân
                        </h3>

                        <form class="profile-form" id="update-profile-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Họ và tên</label>
                                    <input type="text" class="form-input" id="profile-fullname"
                                        value="<%= (user && user.TenNguoiDung) ? user.TenNguoiDung : '' %>" required>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Ngày sinh</label>
                                    <% 
                                        let formattedDate = '';
                                        if (user && user.NgaySinh) {
                                            const d = new Date(user.NgaySinh);
                                            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                                            formattedDate = d.toISOString().split('T')[0];
                                        }
                                    %>
                                    <input type="date" class="form-input" id="profile-birthday" value="<%= formattedDate %>">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-input readonly" id="profile-email" 
                                        value="<%= (user && user.Email) ? user.Email : '' %>" readonly>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Số điện thoại</label>
                                    <input type="tel" class="form-input" id="profile-phone" 
                                        value="<%= (user && user.SoDienThoai) ? user.SoDienThoai : '' %>">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Giới tính</label>
                                    <select class="form-input" id="profile-gender">
                                        <option value="Nam" <%= (user && user.GioiTinh === 'Nam') ? 'selected' : '' %>>Nam</option>
                                        <option value="Nữ" <%= (user && user.GioiTinh === 'Nữ') ? 'selected' : '' %>>Nữ</option>
                                        <option value="Khác" <%= (user && user.GioiTinh === 'Khác') ? 'selected' : '' %>>Khác</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Địa chỉ</label>
                                    <input type="text" class="form-input" id="profile-address" 
                                        value="<%= (user && user.DiaChi) ? user.DiaChi : '' %>" placeholder="Nhập địa chỉ của bạn">
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Lưu thay đổi
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="openChangePasswordModal()">
                                    <i class="fas fa-key"></i> Đổi mật khẩu
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Orders Tab -->
                    <div class="tab-pane" id="orders">
                        <div class="orders-header">
                            <h3 class="section-title">
                                <i class="fas fa-shopping-bag"></i>
                                Lịch sử đơn hàng
                            </h3>
                            <div class="orders-filter">
                                <select class="form-input" id="order-status-filter">
                                    <option value="">Tất cả đơn hàng</option>
                                    <option value="Chờ xác nhận">Chờ xác nhận</option>
                                    <option value="Đang giao">Đang giao</option>
                                    <option value="Đã giao">Đã giao</option>
                                    <option value="Đã hủy">Đã hủy</option>
                                </select>
                            </div>
                        </div>

                        <!-- Orders Container - Dạng thẻ (card) -->
                        <div id="orders-table-body">
                            <!-- Orders will be displayed here as cards -->
                        </div>
                        
                        <div id="orders-pagination" class="pagination"></div>
                    </div>

                    <!-- Addresses Tab -->
                    <div class="tab-pane" id="addresses">
                        <div class="addresses-header">
                            <h3 class="section-title">
                                <i class="fas fa-map-marker-alt"></i>
                                Sổ địa chỉ
                            </h3>
                            <button class="btn btn-primary" onclick="openAddressModal()">
                                <i class="fas fa-plus"></i> Thêm địa chỉ mới
                            </button>
                        </div>

                        <div class="address-grid" id="addresses-container">
                            <div class="loading">Đang tải địa chỉ...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Modal Chi Tiết Đơn Hàng -->
<div id="order-detail-modal" class="modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-container modal-lg">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="fas fa-receipt"></i>
                Chi tiết đơn hàng
            </h3>
            <button class="modal-close" onclick="closeOrderDetailModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div id="order-detail-content">
                <!-- Order details will be loaded here -->
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin"></i> Đang tải...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đổi mật khẩu -->
<div id="change-password-modal" class="modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-container">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="fas fa-key"></i>
                Đổi mật khẩu
            </h3>
            <button class="modal-close" onclick="closeChangePasswordModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="change-password-form" onsubmit="submitChangePassword(event)">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock"></i>
                        Mật khẩu hiện tại
                    </label>
                    <div class="password-input-wrapper">
                        <input type="password" id="current-password" class="form-input" 
                            placeholder="Nhập mật khẩu hiện tại" required>
                        <button type="button" class="toggle-password" onclick="togglePassword('current-password')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-key"></i>
                        Mật khẩu mới
                    </label>
                    <div class="password-input-wrapper">
                        <input type="password" id="new-password" class="form-input" 
                            placeholder="Nhập mật khẩu mới (ít nhất 6 ký tự)" required>
                        <button type="button" class="toggle-password" onclick="togglePassword('new-password')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-strength" id="password-strength">
                        <div class="strength-bar"></div>
                        <div class="strength-bar"></div>
                        <div class="strength-bar"></div>
                        <div class="strength-bar"></div>
                        <span class="strength-text"></span>
                    </div>
                    <ul class="password-requirements" id="password-requirements">
                        <li id="req-length"><i class="fas fa-circle"></i> Ít nhất 6 ký tự</li>
                        <li id="req-uppercase"><i class="fas fa-circle"></i> Ít nhất 1 chữ hoa (A-Z)</li>
                        <li id="req-lowercase"><i class="fas fa-circle"></i> Ít nhất 1 chữ thường (a-z)</li>
                        <li id="req-number"><i class="fas fa-circle"></i> Ít nhất 1 số (0-9)</li>
                        <li id="req-special"><i class="fas fa-circle"></i> Ít nhất 1 ký tự đặc biệt (!@#$%^&*)</li>
                    </ul>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-check-circle"></i>
                        Xác nhận mật khẩu mới
                    </label>
                    <div class="password-input-wrapper">
                        <input type="password" id="confirm-password" class="form-input" 
                            placeholder="Nhập lại mật khẩu mới" required>
                        <button type="button" class="toggle-password" onclick="togglePassword('confirm-password')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-match-status" id="password-match-status"></div>
                </div>

                <div class="modal-buttons">
                    <button type="button" class="btn btn-secondary" onclick="closeChangePasswordModal()">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="btn btn-primary" id="submit-password-btn">
                        <i class="fas fa-save"></i>
                        Cập nhật mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa địa chỉ -->
<div id="address-modal" class="modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-container modal-sm">
        <div class="modal-header">
            <h3 class="modal-title" id="address-modal-title">
                <i class="fas fa-plus"></i>
                Thêm địa chỉ mới
            </h3>
            <button class="modal-close" onclick="closeAddressModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="address-form" onsubmit="submitAddress(event)">
                <input type="hidden" id="address-id">
                <div class="form-group">
                    <label class="form-label">Họ tên</label>
                    <input type="text" id="address-fullname" class="form-input" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <input type="tel" id="address-phone" class="form-input" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Địa chỉ</label>
                    <input type="text" id="address-detail" class="form-input" required>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" id="address-default"> Đặt làm địa chỉ mặc định
                    </label>
                </div>
                <div class="modal-buttons">
                    <button type="button" class="btn btn-secondary" onclick="closeAddressModal()">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu địa chỉ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/CSS/User.css">
<script src="/JS/User.js"></script>

<%- include('partials/footer') %>