    <script>
        // Hàm gọi API và cập nhật số lượng trên badge
        async function updateCartBadge() {
            try {
                const response = await fetch('/api/cart', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const result = await response.json();
                    
                    if (result.success && result.data) {
                        const totalQuantity = result.data.reduce((sum, item) => sum + item.SoLuong, 0);
                        const cartCountElement = document.querySelector('.cart-count');
                        if (cartCountElement) {
                            cartCountElement.textContent = totalQuantity;
                        }
                    }
                } 
                else if (response.status === 401) {
                    const cartCountElement = document.querySelector('.cart-count');
                    if (cartCountElement) {
                        cartCountElement.textContent = '0';
                    }
                }
            } catch (error) {
                console.error("Lỗi khi tải số lượng giỏ hàng:", error);
            }
        }

        // Xử lý dropdown avatar
        function initAvatarDropdown() {
            const avatarDropdown = document.getElementById('avatar-dropdown');
            if (!avatarDropdown) return;

            const avatarBtn = avatarDropdown.querySelector('.icon-btn');
            
            avatarBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                avatarDropdown.classList.toggle('active');
            });

            const logoutLink = document.getElementById('logout-link');
            if (logoutLink) {
                logoutLink.addEventListener('click', async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    try {
                        const response = await fetch('/api/auth/logout', {
                            method: 'POST',
                            credentials: 'include'
                        });
                        
                        if (response.ok) {
                            const data = await response.json();
                            if (data.success) {
                                localStorage.removeItem('token');
                                localStorage.removeItem('user');
                                window.location.href = '/';
                            } else {
                                window.location.href = '/dangnhap';
                            }
                        } else {
                            window.location.href = '/dangnhap';
                        }
                    } catch (error) {
                        console.error('Lỗi đăng xuất:', error);
                        window.location.reload();
                    }
                });
            }

            document.addEventListener('click', function(e) {
                if (avatarDropdown && !avatarDropdown.contains(e.target)) {
                    avatarDropdown.classList.remove('active');
                }
            });
        }

        // Xử lý thanh tìm kiếm nâng cấp
        function initSearchExpand() {
            const searchWrapper = document.getElementById('search-wrapper');
            const searchToggleBtn = document.getElementById('search-toggle-btn');
            const searchInput = document.getElementById('search-input');
            const searchSubmit = document.getElementById('search-btn-submit');
            const searchClear = document.getElementById('search-clear-btn');
            const suggestions = document.querySelectorAll('.suggestion-item');

            // Mở/đóng thanh tìm kiếm
            if (searchToggleBtn) {
                searchToggleBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    searchWrapper.classList.toggle('active');
                    if (searchWrapper.classList.contains('active')) {
                        setTimeout(() => {
                            searchInput.focus();
                        }, 150);
                    } else {
                        if (searchInput) searchInput.value = '';
                        hideSuggestions();
                    }
                });
            }

            // Xóa nội dung input
            if (searchClear) {
                searchClear.addEventListener('click', () => {
                    searchInput.value = '';
                    searchInput.focus();
                    hideSuggestions();
                });
            }

            // Ẩn gợi ý
            function hideSuggestions() {
                const dropdown = document.getElementById('search-suggestions');
                if (dropdown) dropdown.style.display = 'none';
            }

            // Hiện gợi ý
            function showSuggestions() {
                const dropdown = document.getElementById('search-suggestions');
                if (dropdown && searchWrapper.classList.contains('active')) {
                    dropdown.style.display = 'block';
                }
            }

            // Thực hiện tìm kiếm
            function performSearch(searchTerm) {
                const term = searchTerm.trim();
                if (term) {
                    window.location.href = `/search?q=${encodeURIComponent(term)}`;
                }
            }

            // Lọc gợi ý theo từ khóa
            function filterSuggestions(keyword) {
                const dropdown = document.getElementById('search-suggestions');
                if (!dropdown) return;
                
                const filtered = keyword.trim().toLowerCase();
                const items = dropdown.querySelectorAll('.suggestion-item');
                let hasMatch = false;
                
                items.forEach(item => {
                    const text = item.querySelector('span').textContent.toLowerCase();
                    if (filtered === '' || text.includes(filtered)) {
                        item.style.display = 'flex';
                        hasMatch = true;
                    } else {
                        item.style.display = 'none';
                    }
                });
                
                dropdown.style.display = hasMatch && filtered !== '' ? 'block' : 'none';
            }

            // Xử lý input
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const value = e.target.value;
                    if (value) {
                        searchToggleBtn.classList.add('search-has-value');
                        filterSuggestions(value);
                        showSuggestions();
                    } else {
                        searchToggleBtn.classList.remove('search-has-value');
                        hideSuggestions();
                    }
                });

                searchInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        performSearch(searchInput.value);
                    }
                });

                searchInput.addEventListener('blur', () => {
                    setTimeout(() => {
                        hideSuggestions();
                    }, 200);
                });
            }

            // Click nút tìm kiếm
            if (searchSubmit) {
                searchSubmit.addEventListener('click', () => {
                    performSearch(searchInput.value);
                });
            }

            // Click vào gợi ý
            suggestions.forEach(suggestion => {
                suggestion.addEventListener('click', () => {
                    const searchValue = suggestion.getAttribute('data-search') || 
                                      suggestion.querySelector('span')?.textContent;
                    if (searchValue) {
                        searchInput.value = searchValue;
                        performSearch(searchValue);
                    }
                });
            });

            // Đóng khi click ra ngoài
            document.addEventListener('click', (e) => {
                if (window.innerWidth > 768) {
                    if (searchWrapper && !searchWrapper.contains(e.target)) {
                        searchWrapper.classList.remove('active');
                        if (searchInput) searchInput.value = '';
                        hideSuggestions();
                    }
                }
            });
        }

        // Chạy các hàm khi DOM load xong
        document.addEventListener('DOMContentLoaded', () => {
            updateCartBadge();
            initAvatarDropdown();
            initSearchExpand();
        });
    </script>
</body>

