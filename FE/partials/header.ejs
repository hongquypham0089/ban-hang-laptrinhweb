<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Computer - N9 | Gaming Gear & PC Components</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Exo+2:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/CSS/TrangChu.css">
    <script src="/JS/User.js"></script>
    

    <style>
        /* Avatar header */
        .icon-btn img {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #00f3ff;
            box-shadow: 0 0 10px #00f3ff;
            transition: 0.3s;
        }

        .icon-btn img:hover {
            transform: scale(1.1);
        }

        /* Dropdown menu cho avatar */
        .avatar-dropdown {
            position: relative;
            cursor: pointer;
        }

        .avatar-dropdown .dropdown-content {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: rgba(10, 20, 30, 0.95);
            backdrop-filter: blur(12px);
            background: linear-gradient(135deg, rgba(15, 25, 35, 0.95) 0%, rgba(10, 20, 30, 0.98) 100%);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 12px;
            min-width: 180px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3), 0 0 15px rgba(0, 243, 255, 0.2);
            z-index: 1000;
            overflow: hidden;
            animation: fadeInDown 0.2s ease;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .avatar-dropdown .dropdown-content a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 18px;
            color: #e0e0e0;
            text-decoration: none;
            font-size: 14px;
            font-family: 'Exo 2', sans-serif;
            transition: all 0.2s;
            border-bottom: 1px solid rgba(0, 243, 255, 0.1);
        }

        .avatar-dropdown .dropdown-content a:last-child {
            border-bottom: none;
        }

        .avatar-dropdown .dropdown-content a:hover {
            background: rgba(0, 243, 255, 0.15);
            color: #00f3ff;
            padding-left: 22px;
        }

        .avatar-dropdown .dropdown-content a i {
            width: 20px;
            font-size: 16px;
            color: #00f3ff;
        }

        /* Khi dropdown mở */
        .avatar-dropdown.active .dropdown-content {
            display: block;
        }

        /* NÂNG CẤP: Search Bar với hiệu ứng cao cấp hơn */
        .search-wrapper {
            position: relative;
            display: inline-block;
        }

        .search-expand {
            position: absolute;
            top: 50%;
            right: calc(100% + 5px);
            transform: translateY(-50%) scaleX(0);
            transform-origin: right;
            width: 0;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            background: linear-gradient(135deg, rgba(15, 25, 35, 0.98), rgba(10, 20, 30, 0.98));
            backdrop-filter: blur(12px);
            border-radius: 60px;
            border: 1px solid rgba(0, 243, 255, 0.4);
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.2);
            margin-right: 5px;
        }

        .search-wrapper.active .search-expand {
            width: 320px;
            transform: translateY(-50%) scaleX(1);
            padding: 4px;
        }

        .search-expand-form {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .search-expand-input {
            flex: 1;
            background: none;
            border: none;
            padding: 10px 18px;
            color: white;
            font-size: 0.95rem;
            font-family: 'Exo 2', sans-serif;
            outline: none;
        }

        .search-expand-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
            font-style: italic;
        }

        .search-expand-btn {
            background: linear-gradient(135deg, #00f3ff, #b967ff);
            border: none;
            padding: 8px;
            border-radius: 50px;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9rem;
            font-weight: 600;
            font-family: 'Orbitron', sans-serif;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .search-expand-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.5);
        }

        .search-expand-clear {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: 0.3s;
            display: none;
        }

        .search-expand-clear:hover {
            color: #ff2a6d;
            transform: rotate(90deg);
        }

        .search-wrapper.active .search-expand-clear {
            display: flex;
        }

        /* Nút tìm kiếm chính */
        #search-toggle-btn {
            transition: all 0.3s;
            cursor: pointer;
        }

        .search-wrapper.active #search-toggle-btn {
            color: #00f3ff;
            text-shadow: 0 0 10px #00f3ff;
        }

        /* Search suggestions dropdown */
        .search-suggestions-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            right: 0;
            background: rgba(10, 20, 30, 0.98);
            backdrop-filter: blur(12px);
            border-radius: 16px;
            border: 1px solid rgba(0, 243, 255, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            z-index: 1000;
            display: none;
            animation: fadeInUp 0.2s ease;
        }

        .search-wrapper.active .search-suggestions-dropdown {
            display: block;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .suggestion-item {
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: 0.2s;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .suggestion-item:last-child {
            border-bottom: none;
        }

        .suggestion-item:hover {
            background: rgba(0, 243, 255, 0.1);
            padding-left: 22px;
        }

        .suggestion-item i {
            color: #00f3ff;
            width: 20px;
        }

        .suggestion-item span {
            color: white;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .search-wrapper.active .search-expand {
                width: 260px;
            }
        }

        @media (max-width: 768px) {
            .search-wrapper.active .search-expand {
                position: fixed;
                top: 70px;
                left: 50%;
                transform: translateX(-50%) scaleX(1);
                width: 90%;
                z-index: 1001;
                margin-right: 0;
            }
            
            .search-expand {
                transform-origin: center;
            }
            
            .search-expand-btn span {
                display: none;
            }
            
            .search-expand-btn {
                padding: 8px 15px;
            }
        }

        /* Pulse animation cho nút tìm kiếm khi có gợi ý */
        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(0, 243, 255, 0.4);
            }
            50% {
                box-shadow: 0 0 0 10px rgba(0, 243, 255, 0);
            }
        }

        .search-has-value {
            animation: pulse 1.5s ease-in-out;
        }
    </style>
</head>

