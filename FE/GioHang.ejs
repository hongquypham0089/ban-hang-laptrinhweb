<%- include('partials/header') %>

<main class="main-content">
    <div class="container">
        <div class="cart-header">
            <div class="cart-title">
                <i class="fas fa-shopping-cart"></i>
                Giỏ hàng của bạn
                <span class="cart-count-badge" id="cart-count">
                    0 sản phẩm
                </span>
            </div>
            <a href="/" class="continue-shopping">
                <i class="fas fa-arrow-left"></i>
                Tiếp tục mua sắm
            </a>
        </div>

        <div class="cart-container">
            <div class="cart-items">
                <div class="cart-items-header">
                    <label class="select-all">
                        <input type="checkbox" class="select-all-checkbox" id="select-all" checked onchange="toggleSelectAll()">
                        <span>Chọn tất cả</span>
                    </label>
                    <button class="delete-selected" onclick="deleteSelected()">
                        <i class="fas fa-trash-alt"></i>
                        Xóa đã chọn
                    </button>
                </div>

                <div class="cart-items-body" id="cart-items-body">
                    <!-- Cart items will be loaded by JavaScript -->
                </div>
            </div>

            <div class="cart-summary">
                <h3 class="summary-title">
                    <i class="fas fa-calculator"></i>
                    Tổng cộng
                </h3>

                <div class="summary-row">
                    <span>Tạm tính:</span>
                    <span id="subtotal">0₫</span>
                </div>

                <div class="summary-row">
                    <span>Giảm giá:</span>
                    <span id="discount-amount">0₫</span>
                </div>

                <div class="summary-row">
                    <span>Phí vận chuyển:</span>
                    <span id="shipping">Miễn phí</span>
                </div>

                <div class="discount-input">
                    <input type="text" placeholder="Nhập mã giảm giá (GAMING50, SAVE100K, WELCOME)" id="discount-code">
                    <button class="apply-btn" onclick="applyDiscount()">Áp dụng</button>
                </div>

                <div class="summary-row total">
                    <span>Tổng thanh toán:</span>
                    <span id="total">0₫</span>
                </div>

                <button class="checkout-btn" onclick="checkout()">
                    <i class="fas fa-lock"></i>
                    Thanh toán ngay
                </button>

                <div class="payment-methods">
                    <i class="fab fa-cc-visa" title="Visa"></i>
                    <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                    <i class="fab fa-cc-paypal" title="PayPal"></i>
                    <i class="fas fa-money-bill-wave" title="Tiền mặt"></i>
                    <i class="fab fa-cc-apple-pay" title="Apple Pay"></i>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Loading Overlay -->
<div class="loading-overlay">
    <div class="loading-spinner"></div>
</div>

<link rel="stylesheet" href="/CSS/GioHang.css">
<script src="/JS/GioHang.js"></script>

<%- include('partials/footer') %>